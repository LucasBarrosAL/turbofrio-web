---
import "../styles/modern-normalize.css"
import "../styles/globals.css"

const { title = "Turbo Frio" } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/turbofrio-web/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <meta
      name="description"
      content="Serviços de Climatização e Refrigeração, Residencial Comercial e
        Industrial."
    />
    <meta name="robots" content="index, follow" />

    <!-- Facebook, linkedIn, etc...  -->
    <meta property="og:title" content="Turbo Frio" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.turbofrio.com.br/" />
    <meta
      property="og:description"
      content="Serviços de Climatização e Refrigeração, Residencial Comercial e Industrial."
    />
    <!-- <meta
      property="og:image"
      content=""
    /> -->
    <!-- <meta property="og:image:alt" content="" /> -->

    <!-- X/twitter  -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Turbo Frio" />
    <meta
      name="twitter:description"
      content="Serviços de Climatização e Refrigeração, Residencial Comercial e Industrial."
    />
    <!-- <meta name="twitter:image" content="" /> -->
  </head>
  <body>
    <slot />
  </body>
</html>
